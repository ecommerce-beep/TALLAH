{# fix simple menu  #}
<script>
document.addEventListener("DOMContentLoaded", function () {

    const simpleMenu = document.getElementById("simple-menu");
    const ad = document.querySelector("salla-advertisement");
    const header = document.querySelector("#mainnav");

    if (!simpleMenu) return;

    function getAdHeight() {
        if (!ad) return 0;

        const style = getComputedStyle(ad);
        const hidden =
            style.display === "none" ||
            style.visibility === "hidden" ||
            style.height === "0px" ||
            ad.offsetHeight === 0;

        return hidden ? 0 : ad.offsetHeight;
    }

    function updateHeaderVariable() {
        const scrolled = window.scrollY > 0;
        const headerHeight = header ? header.getBoundingClientRect().height : 0;
        // Only include ad height when at the top
        const adHeight = !scrolled ? getAdHeight() : 0;

        document.documentElement.style.setProperty(
            "--header-height",
            (headerHeight + adHeight) + "px"
        );
    }

    function updateSimpleMenu() {
        const scrolled = window.scrollY > 0;
        simpleMenu.classList.toggle("scrolled", scrolled);
        simpleMenu.classList.toggle("not-scrolled", !scrolled);
    }

    function updateAll() {
        updateHeaderVariable();
        updateSimpleMenu();
    }

    // Run once immediately
    updateAll();

    // Re-run after a tick so the ad/header have rendered
    setTimeout(updateAll, 100);
    setTimeout(updateAll, 500); // fallback for slow-loading ad

    window.addEventListener("scroll", updateAll);
    window.addEventListener("resize", updateAll);

    // Watch ad for size changes (handles ad appearing/disappearing)
    if (ad) {
        const ro = new ResizeObserver(updateAll);
        ro.observe(ad);
    }
    if (header) {
        const ro = new ResizeObserver(updateAll);
        ro.observe(header);
    }
});
</script>