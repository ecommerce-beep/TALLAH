{# ------------------------------
Global Variables (from Theme)
------------------------------- #}
{% set topnav_bg = theme.settings.get('header-topnav-background') ?? 'var(--600, #000)' %}
{% set _topnav_text_color_raw = theme.settings.get('header-topnav-text-color') %}
{% set topnav_text_color = _topnav_text_color_raw is iterable ? (_topnav_text_color_raw[language.iso_code] ?? '') : (_topnav_text_color_raw ?? '') %}
{% set _topnav_text_raw = theme.settings.get('header-topnav-text') %}
{% set topnav_text = _topnav_text_raw is iterable ? (_topnav_text_raw[language.iso_code] ?? '') : _topnav_text_raw %}
{% set _topnav_special_text_raw = theme.settings.get('header-topnav-special-text') %}
{% set topnav_special_text = _topnav_special_text_raw is iterable ? (_topnav_special_text_raw[language.iso_code] ?? '') : _topnav_special_text_raw %}
{% set topnav_special_text_color = theme.settings.get('header-topnav-special-text-color') ?? '#666666' %}
{% set _link_url_raw = theme.settings.get('header_topnav_link_url') %}
{% set link_url = _link_url_raw is iterable ? (_link_url_raw[language.iso_code] ?? '') : _link_url_raw %}
{% set is_rtl = language.iso_code == 'ar' %}
{% set countdown_target = theme.settings.get('header-topnav-count-down') %}
{% set countdown_bg = theme.settings.get('count-down-background') ?? '#3f3f46' %}
{% set countdown_text = theme.settings.get('count-down-text-color') ?? '#ffffff' %}
{% set header_hover = theme.settings.get('header-hover') %}
{% set header_bg_color = theme.settings.get('header-background-color') ?? '#ffffff' %}
{% set header_text_color = theme.settings.get('header-text-color') ?? '#000000' %}
{% set advanced_menu = theme.settings.get('advanced-menu') %}
{% set add_another_logo = theme.settings.get('add_another_logo')%}
{% set another_logo_img = theme.settings.get('another_logo_img')%}


{# Expose a couple vars to JS context #}
<script>
	
  window.isAdvancedMenuEnabled = {{ advanced_menu ? 'true' : 'false' }};
  window.header_bg_color = '{{ header_bg_color }}';
  window.header_text_color = '{{ header_text_color}}';
  window.isHomePage = "{{ page.slug|default('') }}" === "index";
  window.languageCode = '{{ language.iso_code }}';
</script>

 

<header class="store-header {{ header_bg }} {{page.slug == 'index'  ? 'w-full absolute top-0 left-0 home' : 'relative'}} z-50">
	{# =====================================
	      1) TOP NOTIFICATION BAR (Clickable)
	      ====================================== #}

	{# =====================================
	      2) HEADER CORE (Hover styles supported)
	      ====================================== #}
		{% if page.slug == 'index' %}
		{# Homepage header variables #}
			{% if header_hover %}
			{% set initial_bg = 'linear-gradient(0deg, rgba(17, 16, 16, 0) 0%, rgba(17, 16, 16, 0.1) 10%, rgba(17, 16, 16, 0.6) 65%)' %}
			{% set initial_text = 'white' %}
			{% set hover_vars = '--hover-bg:' ~ header_bg_color ~ '; --hover-text:' ~ header_text_color %}
		{% else %}
			{% set initial_bg = header_bg_color %}
			{% set initial_text = header_text_color %}
			{% set hover_vars = '' %}
		{% endif %}
	{% else %}
		{# Other pages header variables #}
		{% set initial_bg = header_bg_color %}
		{% set initial_text = header_text_color %}
		{% set hover_vars = '--hover-bg:' ~ header_bg_color ~ '; --hover-text:' ~ header_text_color %}
	{% endif %}
	<style>
        #search-panel-wrapper.scrolled {
			top: 54px;
		}
                #search-panel-wrapper.not-scrolled {
			top: var(--header-height);
                }
		#mainnav:before {
			background: {{initial_bg}};
		}
		#mobile-menu-overlay {
			top: var(--header-height);
		}
		.fixed-pinned #mobile-menu-overlay {
			top: var(--header-height);
		}
		#mobile-menu-overlay.scrolled {
			top: 54px;
		}
		.fixed-pinned.site-header {
			background: {{header_bg_color}}
			!important;
			color: {{header_text_color}}
			!important;
		}

		.fixed-pinned.site-header-mobile {
			background: {{header_bg_color}}
			!important;
			color: {{header_text_color}}
			!important;
		}
		.site-header.header-scrolled {
			background: {{header_bg_color}}
			!important;
			color: {{header_text_color}}
			!important;
		}
		.site-header-mobile.header-scrolled {
			background: {{header_bg_color}}
			!important;
			color: {{header_text_color}}
			!important;
		}
			 #mega-content.scrolled {
				top: 54px;
			}

		
			#simple-menu.scrolled {
				top: 54px;
			}
			#simple-menu.not-scrolled {
				top: var(--header-height);
			}
	</style>

	{# If hover is enabled, define CSS rule to apply dynamic background and text color on hover using CSS variables #}
		<style>
        	{% if header_hover %}

			.site-header.active-overlay {
				background: {{header_bg_color}}
				!important;
				color: {{header_text_color}}
				!important;
			}
			header:hover .inner {
				background: var(--hover-bg) !important;
			}
			header:hover .top-navbar {
				background: var(--hover-bg) !important;
			}
			header:hover .top-navbar :is(p, span, a) {
				color: var(--hover-text) !important;
			}
			header:hover .inner {
				background: var(--hover-bg) !important;
			}
			header:hover .hover-box {
				color: var(--hover-text) !important;
			}
			header:hover .logo-primary{
				opacity:0;
				
			}
			header:hover .logo-secondary{
				opacity:1;
				
			}
			.fixed-pinned.fixed-header{
				.active-overlay {
				background: {{header_bg_color}}
				!important;
				color: {{header_text_color}}
				!important;
			}
			 .inner {
				background: var(--hover-bg) !important;
			}
			.top-navbar {
				background: var(--hover-bg) !important;
			}
			 .top-navbar :is(p, span, a) {
				color: var(--hover-text) !important;
			}
			 .inner {
				background: var(--hover-bg) !important;
			}
			 .hover-box {
				color: var(--hover-text) !important;
			}
			 .logo-primary{
				opacity:0;
				
			}
			 .logo-secondary{
				opacity:1;
				
			}

			}
            	{% endif %}
				{% if page.slug != 'index' %}
				
			header .logo-primary{
				opacity:0;
				
			}
			header .logo-secondary{
				opacity:1;
				
			}
			{% endif %}

		</style>

	{# 'group' = parent hover trigger for .hover-box #}
	<div class="relative">
		<div id="mainnav" class="main-nav-container relative !h-fit !min-h-fit before:absolute before:content-[''] before:h-full before:w-full before:inset-0 before:-z-1">
			
			{% if link_url %}
				<a href="{{ link_url }}" target="_blank" rel="noopener noreferrer" class="block no-underline top-lace" style="text-decoration: none;">
				{% endif %}

				<div class="top-lace flex w-full h-[38px] p-[7px_21px] justify-center items-center gap-[4px] lg:flex lg:px-[30px] lg:py-[7px] lg:justify-between lg:items-center lg:self-stretch {{ is_rtl ? 'flex-row-reverse' : 'flex-row' }}" style="background: {{ topnav_bg }}; color: {{ topnav_text_color }};">
					<div class="flex justify-center items-center gap-1 flex-[1_0_0]">
						<div
							class="flex flex-row items-center gap-1">
							{# Countdown Timer #}
							<div id="countdown" data-countdown-target="{{ countdown_target }}" style="{{ countdown_target ? '' : 'display: none; ' }}background: {{ countdown_bg }}; color: {{ countdown_text }};" class="flex h-[22px] px-[12px] py-[10px] justify-center items-center gap-[4px] rounded-lg lg:flex lg:h-[22px] lg:py-[4px] lg:px-4 lg:gap-2">
								<div class="flex items-baseline gap-0.5">
									<span id="cd-days" class="text-sm font-bold">0</span>
									<span class="text-xs">
										{{ trans('blocks.header.day') }}
									</span>
								</div>
								<span class="text-sm">:</span>
								<div class="flex items-baseline gap-0.5">
									<span id="cd-hours" class="text-sm font-bold">0</span>
									<span class="text-xs">
										{{ trans('blocks.header.hour') }}
									</span>
								</div>
								<span class="text-sm">:</span>
								<div class="flex items-baseline gap-0.5">
									<span id="cd-minutes" class="text-sm font-bold">0</span>
									<span class="text-xs">
										{{ trans('blocks.header.minute') }}
									</span>
								</span>
							</div>
							<span class="text-sm">:</span>
							<div class="flex items-baseline gap-0.5">
								<span id="cd-seconds" class="text-sm font-bold">0</span>
								<span class="text-xs">
									{{ trans('blocks.header.second') }}
								</span>
							</span>
						</div>
					</div>

					{# First Text #}
					<span class="text-center text-[10px] not-italic font-medium leading-[20px] tracking-normal lg:text-xs lg:leading-5 hidden lg:block" style="color: {{ topnav_text_color }}" >
						{{ topnav_text }}
					</span>


					{# Special Text with custom color #}
					<span class="text-center text-[11px] not-italic font-normal leading-[16px] tracking-normal lg:text-xs lg:leading-5" style="color: {{ topnav_special_text_color }}">
						{{ topnav_special_text}}
					</span>

					{# Icon - User Image or Default #}
					<span class="flex justify-center items-center w-[14px] h-[14px] lg:w-4 lg:h-4">
						{% set icon = theme.settings.get('header_topnav_icon_url') %}
						{% set icon_color = theme.settings.get('icon_color') %}
						{% if icon %}
							<i style="color:{{ icon_color }}"
								class="{{ icon ?: 'sicon-home' }} text-sm">
								</i>
						{% endif %}
					</span>
					
				</div>
			</div>
		</div>

		{% if link_url %}
		</a>
	{% endif %}

	<div style="{{ hover_vars }};" class="top-navbar px-16 {{ page.slug != 'index' ? 'not-home' : '' }}">
		<div class="flex justify-between w-full">
			{% if important_links %}
				<salla-menu source="footer" topnav class="lg:!flex !hidden flex-1 justify-start text-background"></salla-menu>
			{% endif %}
			{% if store.scope %}
				<button class="btn--rounded-gray" onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
					<i class="sicon-location rtl:ml-1 ltr:mr-1"></i>
					{{ store.scope.name }}
				</button>
			{% endif %}
			<salla-contacts is-header class="lg:flex hidden flex-1 {{ important_links ? 'lg:justify-center justify-start' : 'justify-start' }} gap-2 text-background"></salla-contacts>
			{% if store.settings.is_multilingual or store.settings.currencies_enabled %}
				<div class="flex items-center localize flex-1 lg:justify-end justify-center">
					<button type="button" onclick="salla.event.dispatch('localization::open')" class="flex items-center justify-start gap-1 basis-0 !p-0">
						<i class="sicon-world text-background"></i>
						<span class="sm:mx-1.5 mx-1 !text-lg text-background">{{ user.language.name }}</span>
						<span class="sm:mx-1.5 mx-1 !text-base text-background">-</span>
						<span class="!text-lg text-background font-[inherit]">{{ currency.symbol }}</span>
					</button>
					<salla-localization-modal></salla-localization-modal>
				</div>
			{% endif %}
		</div>
	</div>

	<div
		class="inner group w-full sticky top-0 z-50" style="{{ hover_vars }};">
		{# header for pc view #}
		<div
			class="site-header hover-box w-full h-[60px] px-16 flex flex-row-reverse justify-between items-center hidden lg:flex" style="color: {{ initial_text }};">
			{# ICONS SECTION #}
			<div
				class="flex flex-1 justify-end items-center md:gap-6 gap-2">
				{# Search Toggle Button #}
				<button id="search-toggle" class="flex items-center justify-center" aria-label="{{ trans('blocks.header.open_search') }}" aria-expanded="false" aria-controls="search-panel">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewbox="0 0 20 20">
						<g clip-path="url(#clip0)">
							<path d="M9.16667 15.8333C12.8486 15.8333 15.8333 12.8486 15.8333 9.16667C15.8333 5.48477 12.8486 2.5 9.16667 2.5C5.48477 2.5 2.5 5.48477 2.5 9.16667C2.5 12.8486 5.48477 15.8333 9.16667 15.8333Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
							<path d="M17.5 17.5L13.875 13.875" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
						</g>
						<defs>
							<clipPath id="clip0">
								<rect width="20" height="20" fill="white"/>
							</clipPath>
						</defs>
					</svg>
				</button>

				{# user icon #}
				{% if user.type == 'user' %}
					<salla-user-menu avatar-only show-header></salla-user-menu>
				{% else %}
					<button onclick="salla.event.dispatch('login::open')" class="flex items-center justify-center cursor-pointer">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewbox="0 0 20 20" fill="none">
							<g clip-path="url(#clip0_5899_2043)">
								<path d="M16.6673 17.5V15.8333C16.6673 14.9493 16.3161 14.1014 15.691 13.4763C15.0659 12.8512 14.218 12.5 13.334 12.5H6.66732C5.78326 12.5 4.93542 12.8512 4.31029 13.4763C3.68517 14.1014 3.33398 14.9493 3.33398 15.8333V17.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M9.99935 9.16667C11.8403 9.16667 13.3327 7.67428 13.3327 5.83333C13.3327 3.99238 11.8403 2.5 9.99935 2.5C8.1584 2.5 6.66602 3.99238 6.66602 5.83333C6.66602 7.67428 8.1584 9.16667 9.99935 9.16667Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
							</g>
							<defs>
								<clipPath id="clip0_5899_2043">
									<rect width="20" height="20" fill="white"/>
								</clipPath>
							</defs>
						</svg>
					</button>
				{% endif %}

				{# Fav icon #}
				<a href="{{ url('wishlist') }}" class="flex items-center justify-center z-50 relative" aria-label="Go to wishlist">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewbox="0 0 20 20" fill="none">
						<path d="M16.2796 4.55371C17.9068 6.1809 17.9068 8.81908 16.2796 10.4463L10.7071 16.0188C10.3166 16.4093 9.68341 16.4093 9.29288 16.0188L3.72039 10.4463C2.0932 8.81908 2.0932 6.1809 3.72039 4.55371C5.014 3.2601 6.57547 2.86401 8.15104 3.6328C8.7764 3.93794 9.59634 4.55371 9.99999 5.35806C10.4036 4.55371 11.2236 3.93794 11.8489 3.6328C13.4245 2.86401 14.986 3.2601 16.2796 4.55371Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</a>

				{# Cart icon #}
				{% if theme.settings.get('enable_side_cart') %}
					{% include 'pages.partials.cart_options.twig' %}
				{% else %}
					<a class="relative flex items-center !min-h-fit !min-w-fit px-2" href="{{ store.url }}/cart">
						<salla-cart-summary class="my-summary">
							{% if cart_icon_choose %}
								{% if cart_icon_type == 'cart_1' %}
									<i class="sicon-shopping text-xl !block"></i>
								{% elseif cart_icon_type == 'cart_2' %}
									<i class="sicon-shopping-basket text-xl !block"></i>
								{% elseif cart_icon_type == 'cart_3' %}
									<i class="sicon-shopping-bag text-xl !block"></i>
								{% elseif cart_icon_type == 'cart_4' %}
									<i class="sicon-luggage-cart text-xl !block"></i>
								{% elseif cart_icon_type == 'cart_5' %}
									<i class="sicon-cart-add text-xl !block"></i>
								{% else %}
									<i class="sicon-shopping text-xl !block"></i>
								{% endif %}
							{% else %}
								<i class="sicon-shopping text-xl !block"></i>
							{% endif %}
						</salla-cart-summary>
					</a>
				{% endif %}
			</div>

			{# LOGO SECTION #}
			<div class="flex flex-col py-5 px-3 gap-[12px] flex-1 justify-center items-center" style="color: {{ initial_text }};">
				<a class="navbar-brand" href="{{ store.url }}">
					{% if add_another_logo and another_logo_img %}

<div class="relative  w-full h-full group">

							<img
									src="{{ store.logo }}"
									class="logo-primary w-full h-full object-contain transition-opacity duration-300 group-hover:opacity-0"
									alt="{{ store.name }}"
								>

								<img
									src="{{ another_logo_img }}"
									class="logo-secondary absolute inset-0 w-full h-full object-contain opacity-0 transition-opacity duration-300 group-hover:opacity-100"
									alt="{{ store.name }} alternate logo"
								>


						</div>

					{% else %}

						<img
							fetchpriority="high"
							width="100%"
							height="100%"
							loading="eager"
							src="{{ store.logo }}"
							alt="{{ store.name }} logo"
						>

					{% endif %}

					{% if is_page('index') %}
						<h1 class="sr-only">{{ store.name }}</h1>
					{% else %}
						<h2 class="sr-only">{{ store.name }}</h2>
					{% endif %}
				</a>
			</div>

			{# Mega menu wrapper #}
			<div id="custom-mega-menu-wrapper" class="hidden lg:relative lg:h-full lg:flex lg:items-center flex-1 justify-start not-scrolled">
				<div
					id="custom-mega-menu" class="relative h-full">
					<!-- Tabs -->
					<ul id="menu-tabs" class="flex gap-6 h-full items-center">
						<li class="menu-skeleton h-4 w-16 rounded bg-current opacity-20 animate-pulse"></li>
						<li class="menu-skeleton h-4 w-20 rounded bg-current opacity-20 animate-pulse"></li>
						<li class="menu-skeleton h-4 w-14 rounded bg-current opacity-20 animate-pulse"></li>
						<li class="menu-skeleton h-4 w-24 rounded bg-current opacity-20 animate-pulse"></li>
						<li class="menu-skeleton h-4 w-16 rounded bg-current opacity-20 animate-pulse"></li>
					</ul>
				</div>
			</div>
		</div>

		{# header for mobile view #}
		<div
			class="site-header-mobile relative px-4 hover-box w-full h-[56px] p-x-[16px] flex flex-row-reverse justify-between items-center shrink-0 lg:hidden" style="color: {{ initial_text }};">

			{# ICONS SECTION #}
			<div
				class="flex items-center gap-4">
				{# user icon #}
				{% if user.type == 'user' %}
					<salla-user-menu avatar-only show-header></salla-user-menu>
				{% else %}
					<button onclick="salla.event.dispatch('login::open')" class="flex items-center justify-center cursor-pointer">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewbox="0 0 20 20" fill="none">
							<g clip-path="url(#clip0_5899_2043)">
								<path d="M16.6673 17.5V15.8333C16.6673 14.9493 16.3161 14.1014 15.691 13.4763C15.0659 12.8512 14.218 12.5 13.334 12.5H6.66732C5.78326 12.5 4.93542 12.8512 4.31029 13.4763C3.68517 14.1014 3.33398 14.9493 3.33398 15.8333V17.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M9.99935 9.16667C11.8403 9.16667 13.3327 7.67428 13.3327 5.83333C13.3327 3.99238 11.8403 2.5 9.99935 2.5C8.1584 2.5 6.66602 3.99238 6.66602 5.83333C6.66602 7.67428 8.1584 9.16667 9.99935 9.16667Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
							</g>
							<defs>
								<clipPath id="clip0_5899_2043">
									<rect width="20" height="20" fill="white"/>
								</clipPath>
							</defs>
						</svg>
					</button>
				{% endif %}

				{# Wishlist #}
				<a href="{{ url('wishlist') }}" class="flex items-center justify-center z-50 relative" aria-label="Go to wishlist">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewbox="0 0 20 20" fill="none">
						<path d="M16.2796 4.55371C17.9068 6.1809 17.9068 8.81908 16.2796 10.4463L10.7071 16.0188C10.3166 16.4093 9.68341 16.4093 9.29288 16.0188L3.72039 10.4463C2.0932 8.81908 2.0932 6.1809 3.72039 4.55371C5.014 3.2601 6.57547 2.86401 8.15104 3.6328C8.7764 3.93794 9.59634 4.55371 9.99999 5.35806C10.4036 4.55371 11.2236 3.93794 11.8489 3.6328C13.4245 2.86401 14.986 3.2601 16.2796 4.55371Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</a>

				{# Cart icon #}
				{% if theme.settings.get('enable_side_cart') %}
					{% include 'pages.partials.cart_options.twig' %}
				{% else %}
					<a class="relative flex items-center !min-h-fit !min-w-fit px-2" href="{{ store.url }}/cart">
						<salla-cart-summary class="my-summary">
							{% if cart_icon_choose %}
								{% if cart_icon_type == 'cart_1' %}
									<i class="sicon-shopping text-xl !block"></i>
								{% elseif cart_icon_type == 'cart_2' %}
									<i class="sicon-shopping-basket text-xl !block"></i>
								{% elseif cart_icon_type == 'cart_3' %}
									<i class="sicon-shopping-bag text-xl !block"></i>
								{% elseif cart_icon_type == 'cart_4' %}
									<i class="sicon-luggage-cart text-xl !block"></i>
								{% elseif cart_icon_type == 'cart_5' %}
									<i class="sicon-cart-add text-xl !block"></i>
								{% else %}
									<i class="sicon-shopping text-xl !block"></i>
								{% endif %}
							{% else %}
								<i class="sicon-shopping text-xl !block"></i>
							{% endif %}
						</salla-cart-summary>
					</a>
				{% endif %}
