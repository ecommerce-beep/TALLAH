<section class="AR-promo-banner AR-promo-banner-{{ position }}">
	<div class="lg:px-10 flex lg:flex-row flex-col items-center justify-between gap-6 lg:gap-12 py-8">
				<div class="lg:w-2/3 text text-font ltr:lg:text-left rtl:lg:text-right text-center order-2 mx-auto flex flex-col gap-4 sm:max-w-3/4 lg:max-w-full max-w-full">

					<h2 class="font-semibold  text-[clamp(1.5rem,1.2704rem+0.9796vw,2.25rem)] leading-snug  " style="color: {{ component.block_title_color }};">
						{{ component.block_title }}
					</h2>
					<p class="font-medium text-base max-w-3/4 mx-auto lg:m-0"
						style="color: {{ component.subtext_color }};">
						&quot;{{ component.subtext }}&quot;
					</p>
					{% if component.url_text %}
						<a href="{{component.url}}" class="text-sm font-semibold underline lg:mt-4"
						 style="color: {{ component.url_color }};">
							{{ component.url_text | upper }}
						</a>
					{% endif %}

				</div>

			<div class="overflow-hidden h-[40.625rem]  text-[start] lg:w-[38%] w-full max-w-132 lg:max-w-1/3 relative">
	
				<img src="{{ component.banner_image }}" class=" h-full w-full object-cover " alt=""/>
			</div>
		</div>
	</div>
</section>


<style>
	@media(min-width: 375px) {
		.AR-promo-banner-{{position}} .s-products-list-vertical-cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.AR-promo-banner-{{position}} .s-slider-block__title-nav {
		display: none;
	}
	.AR-promo-banner-{{position}} .salla-slider[type]:not(.hydrated) > div > div,
	salla-slider[type]:not(.hydrated) .swiper > div > div > div,
	.carousel-slider .swiper-wrapper > div {
		padding-left: 0;
		padding-right: 0;
	}
    .AR-promo-banner-{{position}} .swiper.s-slider-container{
        padding:0px !important;
    }
    .AR-promo-banner-{{position}} .swiper-wrapper.s-slider-swiper-wrapper{
        justify-content: space-between;
    }
    .AR-promo-banner-{{position}} .s-product-card-entry{
        height:clamp(23.563rem, 21.1906rem + 10.1224vw, 31.313rem) !important;
    }
</style>
