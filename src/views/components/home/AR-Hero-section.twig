{% set has_many_banners = component.banner|length > 1 %}
<section class="AR-slider-hero-section AR-slider-hero-section-{{position}}">
	<div class="wrapper">
		<div class="relative">
			{# banner #}
			<salla-slider id="sub-banner-slider-{{position}}" class="subbanner-slider" {% if has_many_banners %}auto-play="true" {% endif %}loop="true"
				show-controls="false" type="carousel" slider-config='{
    "parallax": true,
    "pagination": {
      "el": ".AR-slider-hero-section-{{position}} .swiper-pagination",
      "type": "bullets",
      "clickable": true
    },
    "spaceBetween": 0,
    {% if has_many_banners %}
    "autoplay": {
      "delay": 2000,
      "disableOnInteraction": false,
      "pauseOnMouseEnter": true
    }, 
    {% endif %}
    "lazy": true, 
    "speed": 1000,
    "loop": true
  }'>
				<div slot="items">
					{% for item in component.banner %}
						<div class="banner banner-{{loop.index}} flex flex-col relative md:h-[90vh] h-[100svh] md:px-4 px-2 py-16 overflow-hidden">

							{% if not item.button_text %}
							<a class="w-full h-full absolute inset-0 z-[5]" href="{{item.url}}"></a>
							{% endif %}

							<div class="text-wrapper h-full flex flex-col {{ item.items_alignment == ['center'] ? 'text-center items-center' : item.items_alignment == ['start'] ? 'text-start items-start' : 'text-end items-end' }} {{ item.items_alignment_vertical == ['start'] ? 'justify-start' : item.items_alignment_vertical == ['end'] ? 'justify-end' : 'justify-center' }} mx-auto relative z-2 container">

								<div class="position {{ item.items_alignment == ['center'] ? 'text-center items-center' : item.items_alignment == ['start'] ? 'text-start items-start' : 'text-end items-end' }} flex flex-col sm:gap-4 gap-2">
									{% if item.block_title %}
									<h1 data-swiper-parallax="-700"
										class="leading-snug blocktitle blocktitle-{{loop.index}} text-[clamp(1.5rem,1.0408rem+1.9592vw,3rem)] text-background font-medium transition-all duration-700 ease-in-out">
										{{item.block_title}}</h1>
									{% endif %}
									{% if item.subtext %}
									<p data-swiper-parallax="-500"
										class="subtext subtext-{{loop.index}} text-background font-light text-[clamp(0.875rem,0.7602rem+0.4898vw,1.25rem)] transition-all duration-700 ease-in-out">
										{{item.subtext}}</p>
									{% endif %}
									{% if not item.button_bottom %}
									{% if item.button_text %}
									<a data-swiper-parallax="-300"
										class="block text-center button button-{{loop.index}} mt-2 rounded-md bg-primary text-background px-4 sm:px-7 py-2 text-[clamp(0.75rem,0.6447rem+0.4493vw,1.094rem)] transition-all hover:bg-background hover:text-primary border border-[color-mix(in srgb,var(--color-primary)15%,white)] hover:border-primary justify-self-end"
										href="{{item.url}}">{{item.button_text}}</a>
									{% endif %}
									{% endif %}
								</div>
							</div>

							{% if item.button_bottom %}
							{% if item.button_text %}
							<a data-swiper-parallax="-300"
								class="block z-2 text-center button button-{{loop.index}} self-center rounded-md bg-primary mt-auto text-background px-4 sm:px-7 py-2 text-[clamp(0.75rem,0.6447rem+0.4493vw,1.094rem)] transition-all hover:bg-background hover:text-primary border border-[color-mix(in srgb,var(--color-primary)15%,white)] hover:border-primary justify-self-end"
								href="{{item.url}}">{{item.button_text}}</a>
							{% endif %}
							{% endif %}

						</div> 
					{% endfor %}
				</div>

			</salla-slider>
			<div class="swiper-pagination !bottom-8 justify-center gap-2 !absolute items-center m-0 flex !w-1/4 !left-1/2 -translate-x-1/2">
			</div>
			{# Pause/play for the automatic slide change (WCAG 2.2.2). Shown by home.js once the slider is ready #}
			{% if has_many_banners %}
			<button type="button" class="hero-autoplay-toggle" hidden
				aria-label="{{ trans('hero.pause_autoplay') }}"
				data-label-pause="{{ trans('hero.pause_autoplay') }}"
				data-label-play="{{ trans('hero.resume_autoplay') }}">
				<svg class="icon-pause" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><rect x="3" y="2" width="3.5" height="12" rx="1"/><rect x="9.5" y="2" width="3.5" height="12" rx="1"/></svg>
				<svg class="icon-play" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false" hidden><path d="M4 2.5v11a1 1 0 0 0 1.5.86l9-5.5a1 1 0 0 0 0-1.72l-9-5.5A1 1 0 0 0 4 2.5z"/></svg>
			</button>
			{% endif %}

		</div>
	</div>
</section>

<style>
	.AR-slider-hero-section .swiper-pagination-bullet {
		margin: 0px;
		background: var(--color-background);
		height: 2px;
		flex: 1 1 0%;
		transition: all .5s ease-in-out;
	}

	.AR-slider-hero-section .swiper-pagination-bullet {
		color: var(--color-background);
	}

	{% for item in component.banner %}

	.AR-slider-hero-section-{{position}} .text-wrapper .blocktitle-{{loop.index}} {
		color: {{item.blocktitle_color}};
	}

	.AR-slider-hero-section-{{position}} .text-wrapper .subtext-{{loop.index}} {
		color: {{item.subtext_color}};
	}

	/* Mobile */
	.AR-slider-hero-section-{{position}} .banner-{{loop.index}} {
		background: url({{item.mobile_bg}}) center center / cover no-repeat;
	}

	{% if item.transparent_button %}
	.AR-slider-hero-section-{{position}} .button-{{loop.index}} {
		background-color: transparent;
		color: {{item.button_text_color}};
		border-color: {{item.button_text_color}};
	}
	.AR-slider-hero-section-{{position}} .button-{{loop.index}}:hover {
		background-color: {{item.button_text_color}};
		color: {{item.button_bg}};
	}
	{% else %}
	.AR-slider-hero-section-{{position}} .button-{{loop.index}} {
		color: {{item.button_text_color}};
		background-color: {{item.button_bg}};
		border-color: {{item.button_text_color}};
	}
	.AR-slider-hero-section-{{position}} .button-{{loop.index}}:hover {
		background-color: {{item.button_text_color}};
		color: {{item.button_bg}};
		border-color: {{item.button_bg}};
	}
	{% endif %}

	/* Desktop */
	@media (min-width: 768px) {
		.AR-slider-hero-section-{{position}} .banner-{{loop.index}} {
			background: url({{item.desktop_bg}}) center center / cover no-repeat;
		}
	}

	{% endfor %}

	{% if component.banner|length > 1 %}
	.AR-slider-hero-section .swiper-slide {
		pointer-events: none;
	}
	.AR-slider-hero-section .swiper-slide.swiper-slide-active {
		pointer-events: all;
	}
	{% endif %}

	.carousel-slider .swiper:where([dir="rtl"], [dir="rtl"] *) {
		padding-left: 0;
	}

	.AR-slider-hero-section .hero-autoplay-toggle {
		position: absolute;
		z-index: 6;
		bottom: 1.5rem;
		inset-inline-end: 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.5);
		color: #fff;
		cursor: pointer;
	}

	.AR-slider-hero-section .hero-autoplay-toggle[hidden],
	.AR-slider-hero-section .hero-autoplay-toggle [hidden] {
		display: none;
	}
</style>